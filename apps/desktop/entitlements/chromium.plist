<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime exceptions for the bundled Chromium (the browser pane).
  V8 compiles JavaScript at runtime, so the browser and its helpers need
  JIT and writable-executable memory; library validation is off because
  Chromium loads its own unsigned-by-us components (SwiftShader, Widevine).
  Applied by scripts/macos-signing.sh sign-chromium.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
